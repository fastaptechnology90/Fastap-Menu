# ─────────────────────────────────────────────────────────────
# Fastap Smart Hospitality OS — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Server ────────────────────────────────────────────────────
PORT=3001
PUBLIC_URL=http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────────────────────
# Start DB:  docker compose up -d   OR   pnpm db:start
# Then:       pnpm db:setup        (creates tables + seeds demo data)
DATABASE_URL=postgresql://fastapmenu:fastapmenu@localhost:5432/fastapmenu
PGHOST=localhost
PGPORT=5432
PGUSER=fastapmenu
PGPASSWORD=yourpassword
PGDATABASE=fastapmenu

# ── Session ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-secure-64-char-random-string

# ── Cookies ───────────────────────────────────────────────────
# Set to true in production (requires HTTPS)
SECURE_COOKIE=false

# ── Payments (Razorpay) ───────────────────────────────────────
# Live online checkout needs both. Super Admin → Integrations can also store keys.
# Without these, guest checkout stays cash-at-counter (fail closed — no fake "paid").
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional Stripe
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=

# ── Guest / staff SMS OTP ─────────────────────────────────────
# Without credentials, production phone OTP returns SMS_NOT_CONNECTED (503).
# Local NODE_ENV=development still echoes a DEV code — never in production.
# Twilio (plain SMS body):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# MSG91 (India DLT — template ID required to send):
MSG91_AUTH_KEY=
MSG91_SENDER_ID=FSTMNU
MSG91_TEMPLATE_ID=
# Optional: ALLOW_DEMO_OTP=1 forces in-memory OTP outside production (staging only).
