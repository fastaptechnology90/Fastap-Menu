# ─────────────────────────────────────────────────────────────
# Fastap Smart Hospitality OS — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Server ────────────────────────────────────────────────────
PORT=3001
PUBLIC_URL=http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────────────────────
# Start DB:  docker compose up -d   OR   pnpm db:start
# Then:       pnpm db:setup        (creates tables + seeds demo data)
DATABASE_URL=postgresql://fastapmenu:fastapmenu@localhost:5432/fastapmenu
PGHOST=localhost
PGPORT=5432
PGUSER=fastapmenu
PGPASSWORD=yourpassword
PGDATABASE=fastapmenu

# ── Session ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-secure-64-char-random-string

# ── Cookies ───────────────────────────────────────────────────
# Set to true in production (requires HTTPS)
SECURE_COOKIE=false
