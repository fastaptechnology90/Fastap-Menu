{
  "name": "fastapmenu",
  "version": "1.0.0",
  "description": "Fastap Smart Hospitality OS — Super Admin Panel",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@esbuild/linux-x64",
      "@esbuild/win32-x64",
      "bcrypt",
      "cpu-features",
      "ssh2",
      "@embedded-postgres/windows-x64"
    ]
  },
  "scripts": {
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:kitchenapp": "cd kitchenapp && flutter run --dart-define=API_MODE=external --dart-define=API_BASE_URL=http://127.0.0.1:8080",
    "dev:waiterapp": "cd waiterapp && flutter run --dart-define=API_MODE=external --dart-define=API_BASE_URL=http://127.0.0.1:8080",
    "dev:housekeepingapp": "cd housekeepingapp && flutter run --dart-define=API_MODE=external --dart-define=API_BASE_URL=http://127.0.0.1:8080",
    "dev:stack": "concurrently -n db,api -c magenta,blue \"node scripts/start-db.mjs\" \"cross-env PORT=8080 pnpm --filter @workspace/api-server run dev\"",
    "smoke:mobile": "cross-env API_BASE=http://127.0.0.1:8080 node scripts/smoke-mobile-api.mjs",
    "smoke:mobile-real": "node scripts/smoke-mobile-real-data.mjs",
    "smoke:mobile-readonly": "node scripts/smoke-mobile-readonly.mjs",
    "smoke:full": "node scripts/smoke-full-stack.mjs",
    "build:apk:kitchen": "cd kitchenapp && flutter build apk --release --dart-define=API_MODE=external --dart-define=APP_ENV=production",
    "build:apk:waiter": "cd waiterapp && flutter build apk --release --dart-define=API_MODE=external --dart-define=APP_ENV=production --dart-define=APP_VARIANT=waiter",
    "build:apk:housekeeping": "cd housekeepingapp && flutter build apk --release --dart-define=API_MODE=external --dart-define=APP_ENV=production --dart-define=APP_VARIANT=housekeeping",
    "build:ios:kitchen": "cd kitchenapp && flutter build ios --release --no-codesign --dart-define=API_MODE=external --dart-define=APP_ENV=production",
    "build:ios:waiter": "cd waiterapp && flutter build ios --release --no-codesign --dart-define=API_MODE=external --dart-define=APP_ENV=production --dart-define=APP_VARIANT=waiter",
    "build:ios:housekeeping": "cd housekeepingapp && flutter build ios --release --no-codesign --dart-define=API_MODE=external --dart-define=APP_ENV=production --dart-define=APP_VARIANT=housekeeping",
    "dev:web": "cross-env PORT=5000 BASE_PATH=/ pnpm --filter @workspace/fastap-admin run dev",
    "dev:user": "concurrently -n db,api,web -c magenta,blue,green \"node scripts/start-db.mjs\" \"cross-env PORT=8080 pnpm --filter @workspace/api-server run dev\" \"cross-env PORT=5000 BASE_PATH=/ pnpm --filter @workspace/fastap-admin run dev\"",
    "preview:user": "concurrently -n api,web -c blue,green \"cross-env PORT=8080 pnpm --filter @workspace/api-server run dev\" \"cross-env PORT=5000 BASE_PATH=/ pnpm --filter @workspace/fastap-admin run serve\"",
    "db:push": "pnpm --filter @workspace/db push",
    "db:seed": "pnpm --filter @workspace/api-server run seed",
    "db:clean-demo": "node scripts/clean-demo-data.mjs",
    "db:clear-invoices": "node scripts/clear-invoice-cache.mjs",
    "db:start": "node scripts/start-db.mjs",
    "db:ensure": "node scripts/ensure-db.mjs",
    "db:setup": "pnpm db:ensure && pnpm db:push && pnpm db:seed",
    "db:init": "node scripts/start-db.mjs && pnpm db:setup",
    "smoke:guest": "node scripts/smoke-guest-api.mjs",
    "smoke:restaurant": "node scripts/smoke-restaurant-api.mjs",
    "smoke:all-panels": "node scripts/smoke-all-panels.mjs",
    "smoke:az": "node scripts/smoke-api-az.mjs",
    "test:demo-login": "node scripts/test-demo-login.mjs",
    "test:analytics-publication": "node scripts/test-analytics-publication.mjs",
    "db:studio": "pnpm --filter @workspace/db exec drizzle-kit studio --config ./drizzle.config.ts",
    "typecheck": "tsc --build",
    "catalog:sync": "node scripts/sync-feature-catalog.mjs",
    "catalog:check": "node scripts/sync-feature-catalog.mjs && git diff --exit-code -- shared/feature-modules.catalog.json kitchenapp/lib/data/generated/feature_module_catalog.g.dart kitchenapp/lib/data/enterprise_feature_catalog.dart",
    "pm2:start": "pm2 start deploy/ecosystem.config.js",
    "pm2:restart": "pm2 restart fastapmenu-api",
    "pm2:stop": "pm2 stop fastapmenu-api",
    "pm2:logs": "pm2 logs fastapmenu-api",
    "pm2:save": "pm2 save",
    "deploy": "bash deploy/deploy.sh",
    "package:vps": "node deploy/package-vps.mjs",
    "deploy:vps": "node deploy/sftp-deploy.mjs",
    "setup:vps": "bash deploy/setup-vps.sh",
    "setup:ssl": "bash deploy/setup-ssl.sh",
    "test:email-verification": "node scripts/test-email-verification.mjs",
    "test:admin-approval": "node scripts/test-admin-approval.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.8.1",
    "ssh2": "^1.16.0",
    "typescript": "~5.9.2"
  }
}
